# Copy to infra/.env ON THE SERVER and fill in. Never commit infra/.env.

# Your free hostname, without https://  (example: myapp.duckdns.org)
DOMAIN=

# Neon, connection pooling OFF. Keep the single quotes: the URL contains "&".
JOBS_DB_URL='jdbc:postgresql://HOST/jobs_db?user=USER&password=PASSWORD&sslmode=require'
MEDIA_DB_URL='jdbc:postgresql://HOST/media_db?user=USER&password=PASSWORD&sslmode=require'

# Two different random values: openssl rand -hex 32
INTERNAL_KEY=
AUTH_SECRET=

# 6g on a 12 GB server (Oracle A1), 5g on an 8 GB one (AWS m7i-flex.large)
JOB_SERVICE_MEM_LIMIT=6g

# --- Stripe (optional). Leave empty and billing is off: everyone is guest or free. ---
# Start with TEST keys (sk_test_...). Switch to live keys only when you are ready to charge.
STRIPE_SECRET_KEY=
# From Developers -> Webhooks -> your endpoint -> Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# The monthly price of your Pro product (price_...)
STRIPE_PRICE_PRO=
# Shown on the Pro card. Display only: keep it in line with the Stripe price. Single quotes keep the $.
PRO_PRICE_LABEL='$9 / month'

# --- Plan limits (optional overrides; these are the defaults) ---
# Seconds of SOURCE video per rolling 24 hours, longest clip in seconds, highest factor, videos at once.
# PLAN_GUEST_DAILY_SECONDS=30
# PLAN_GUEST_MAX_CLIP_SECONDS=10
# PLAN_GUEST_MAX_FACTOR=2
# PLAN_GUEST_MAX_ACTIVE=1
# PLAN_FREE_DAILY_SECONDS=180
# PLAN_FREE_MAX_CLIP_SECONDS=30
# PLAN_FREE_MAX_FACTOR=4
# PLAN_FREE_MAX_ACTIVE=2
# PLAN_PRO_DAILY_SECONDS=1800
# PLAN_PRO_MAX_CLIP_SECONDS=180
# PLAN_PRO_MAX_FACTOR=8
# PLAN_PRO_MAX_ACTIVE=5
